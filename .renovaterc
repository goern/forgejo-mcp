{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:best-practices",
        "default:automergeDigest",
        "mergeConfidence:all-badges",
        ":enableVulnerabilityAlertsWithLabel('security')"
    ],
    "enabled": true,
    "enabledManagers": [
        "npm",
        "docker-compose",
        "dockerfile"
    ],
    "description": [
        "rebaseWhen is deliberately NOT ':rebaseStalePrs'. main advances several times a day from its own digest automerges, so rebase-on-stale force-pushed every open PR roughly hourly, and each new head SHA re-fired both PaC PipelineRuns. PR #359 burned 26 green runs over 10 days that way without a single line changing. Rebase only when a PR genuinely cannot merge."
    ],
    "rebaseWhen": "conflicted",
    "packageRules": [
        {
            "description": "Automerge container image patch, minor, and digest updates; hold major for review",
            "matchDatasources": [
                "docker"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch",
                "digest",
                "pin"
            ],
            "automerge": true
        },
        {
            "description": "Automerge npm patch and minor updates; hold major for review. Without this, npm PRs matched no automerge rule at all and sat open until a human noticed them.",
            "matchManagers": [
                "npm"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "automerge": true
        }
    ]
}
